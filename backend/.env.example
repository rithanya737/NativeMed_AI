# Copy this file to ".env" and fill in your own values.
# NEVER commit the real ".env" file to version control.

# --- LLM provider ---
# Default: Ollama -- a free, fully local/private model server, no API key.
# 1. Install Ollama from https://ollama.com
# 2. Run: ollama pull llama3.2   (or whatever OLLAMA_MODEL you set below)
# 3. That's it -- leave LLM_PROVIDER=ollama and just run the backend.
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Only needed if you switch LLM_PROVIDER to "openai" instead:
# Get a key from https://platform.openai.com/api-keys
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini

# If LLM_PROVIDER=mock (or Ollama/OpenAI aren't reachable), the backend
# falls back to a safe offline extractive mode so the rest of the pipeline
# can still be tested with zero setup.

# --- Database ---
DATABASE_PATH=database/plants.db

# --- Vector store (ChromaDB) ---
VECTORSTORE_PATH=vectorstore/chroma
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
COLLECTION_NAME=nativemed_plants

# --- Retrieval ---
TOP_K_RESULTS=5
MIN_SIMILARITY_SCORE=0.35

# --- Multilingual ---
DEFAULT_LANGUAGE=en
SUPPORTED_LANGUAGES=en,ta,hi,ml,te,kn

# --- Speech ---
WHISPER_MODEL_SIZE=base
TTS_OUTPUT_DIR=data/audio_out

# --- App ---
APP_ENV=development
LOG_LEVEL=INFO
